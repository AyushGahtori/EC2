# Nginx reverse proxy for EC2 agents
# Current host target: 13.206.83.175 (no domain required)

upstream teams_agent {
    server 127.0.0.1:8100;
    keepalive 16;
}

upstream todo_agent {
    server 127.0.0.1:8200;
    keepalive 16;
}

server {
    listen 80;
    server_name 13.206.83.175 _;

    client_max_body_size 2m;

    # Todo agent endpoints
    location /todo/ {
        proxy_pass http://todo_agent;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Convenience health endpoint for todo agent
    location = /todo/health {
        proxy_pass http://todo_agent/health;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Teams agent + email/calendar/auth endpoints
    location / {
        proxy_pass http://teams_agent;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}

# Optional: if you later attach a domain, run certbot and switch to HTTPS.
