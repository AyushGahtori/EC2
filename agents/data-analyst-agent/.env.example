PORT=8042
DATA_ANALYST_DISPLAY_NAME=Data Analyst Agent

# LLM configuration
# Supported providers: auto, gemini, openai, anthropic, ollama, disabled
DATA_ANALYST_LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Anomaly/caching controls
DATA_ANALYST_DATASET_MAX_POINTS=5000
DATA_ANALYST_CACHE_TTL_SECONDS=900
DATA_ANALYST_CACHE_MAX_ENTRIES=512
DATA_ANALYST_STREAM_TOKEN_DELAY_MS=25

# Optional Firestore cache/logging
FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=
