# Runtime
PORT=8012

# Firebase Admin
FIREBASE_SERVICE_ACCOUNT_KEY=/home/ubuntu/app/.secrets/serviceAccountKey.json
GOOGLE_APPLICATION_CREDENTIALS=/home/ubuntu/app/.secrets/serviceAccountKey.json

# Financial API (Strata source-compatible key naming)
FMP_API_KEY=__SET_IN_EC2_RUNTIME__
FMP_BASE_URL=https://financialmodelingprep.com/stable/income-statement
STRATA_DEFAULT_SYMBOL=AAPL

# Optional AI model for insights/query/report summarization
GEMINI_API_KEY=__SET_IN_EC2_RUNTIME__
GEMINI_MODEL_PRO=gemini-2.5-pro
