PORT=8045
SHELFIE_GROCERY_DISPLAY_NAME=Shelfie Grocery Agent

# Runtime + CORS
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:3000

# Provider switch: ollama | ollama_cloud | openai | anthropic | gemini
LLM_PROVIDER=gemini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# Local Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:12b

# Ollama Cloud (optional)
OLLAMA_CLOUD_BASE_URL=https://your-ollama-cloud-openai-endpoint/v1
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_MODEL=gemma3:12b

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Session cache (Redis) with automatic in-memory fallback
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_TTL_SECONDS=86400

# Conversation history (MongoDB) with automatic file fallback
MONGODB_URL=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=shelfie_grocery_agent
MONGODB_MESSAGES_COLLECTION=messages
