# Career Switch Agent - Environment Configuration (EC2)
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Port Configuration ──
PORT=8022

# ── Firebase / Firestore ──
# Path to the Firebase service account JSON key or leave blank to use
# GOOGLE_APPLICATION_CREDENTIALS if configured in the environment.
FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json
FIREBASE_PROJECT_ID=
FIRESTORE_ROLES_COLLECTION=onet_roles

# ── Job Market APIs ──
# JSearch API (RapidAPI)
JSEARCH_API_KEY=
JSEARCH_RAPIDAPI_KEY=
JSEARCH_API_HOST=jsearch.p.rapidapi.com
RAPIDAPI_KEY=
RAPIDAPI_HOST=
JSEARCH_COUNTRY=us
JSEARCH_PAGE=1
JSEARCH_MAX_RESULTS=10

# Adzuna API
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us
ADZUNA_MAX_RESULTS=10

# LinkedIn Jobs API
LINKEDIN_API_KEY=
LINKEDIN_API_HOST=
LINKEDIN_API_BASE_URL=
LINKEDIN_Client_ID=
LINKEDIN_Primary_Client_Secret=
LINKEDIN_COUNTRY=us
LINKEDIN_PAGE=1
LINKEDIN_MAX_RESULTS=10

# ── YouTube API ──
YOUTUBE_API_KEY=
YOUTUBE_MAX_RESULTS_PER_PHASE=2

# ── LLM (Google Gemini) ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-pro
GEMINI_MAX_OUTPUT_TOKENS=4096

# ── Application ──
APP_ENV=production
LOG_LEVEL=INFO
