# Teams Agent — Environment Variables

# Ollama LLM server URL (for intent parsing within the agent)
OLLAMA_URL=http://host.docker.internal:11434/api/chat
OLLAMA_MODEL=qwen2.5:7b

# Microsoft Graph API credentials
# Get these from your Azure / Entra app registration
GRAPH_TENANT_ID=your-tenant-id-here
GRAPH_CLIENT_ID=your-client-id-here

# Server port
PORT=8100

# Twilio Notification Configuration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TO_NUMBER=
TWILIO_CALL_FROM=+18127953318
CALL_TO_NUMBER=
TWILIO_SMS_FROM=+18127953318
SMS_TO_NUMBER=
