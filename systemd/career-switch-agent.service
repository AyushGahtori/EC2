[Unit]
Description=Career Switch Agent FastAPI Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/app/agents/career-switch-agent
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/home/ubuntu/app/agents/career-switch-agent/.env
ExecStart=/home/ubuntu/app/agents/career-switch-agent/venv/bin/uvicorn server:app --host 0.0.0.0 --port 8022 --workers 1
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
