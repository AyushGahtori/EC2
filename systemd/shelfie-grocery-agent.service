[Unit]
Description=Shelfie Grocery Agent FastAPI Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/app/agents/shelfie-grocery-agent
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/ubuntu/app
EnvironmentFile=-/home/ubuntu/app/agents/shelfie-grocery-agent/.env
ExecStart=/home/ubuntu/app/agents/shelfie-grocery-agent/venv/bin/uvicorn server:app --host 0.0.0.0 --port 8045
Restart=always
RestartSec=5
LimitNOFILE=65535
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
