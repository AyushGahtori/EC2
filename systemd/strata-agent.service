[Unit]
Description=Strata Agent FastAPI Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/app/agents/strata-agent
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/home/ubuntu/app/agents/strata-agent/.env
ExecStart=/home/ubuntu/app/agents/strata-agent/venv/bin/uvicorn server:app --host 0.0.0.0 --port 8012 --workers 2
Restart=always
RestartSec=5
LimitNOFILE=65535
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
