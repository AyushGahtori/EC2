PORT=8300

# OAuth app credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match the redirect URI configured in Google Cloud Console.
# If your SnitchX app is on a domain, use that callback URL.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google-auth/callback

# Optional local model extraction defaults used by google-agent internals
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
