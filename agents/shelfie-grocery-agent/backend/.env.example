APP_NAME="Shelfie Agent API"
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:3000

# Provider switch: ollama | ollama_cloud | openai | anthropic | gemini
LLM_PROVIDER=gemini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# Local Ollama (optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:31b-cloud

# Ollama Cloud (optional)
# Set this to your Ollama Cloud OpenAI-compatible endpoint
OLLAMA_CLOUD_BASE_URL=https://your-ollama-cloud-openai-endpoint/v1
OLLAMA_CLOUD_API_KEY=your_ollama_cloud_api_key
OLLAMA_CLOUD_MODEL=gemma4:31b-cloud

# OpenAI fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Anthropic fallback
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=86400

MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=shelfie_agent
MONGODB_MESSAGES_COLLECTION=messages
