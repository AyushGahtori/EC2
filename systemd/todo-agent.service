[Unit]
Description=Todo Agent FastAPI Server
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/app/agents/todo-agent
ExecStart=/home/ubuntu/app/agents/todo-agent/venv/bin/uvicorn api.server:app --host 0.0.0.0 --port 8200
Restart=always
RestartSec=5
Environment=PATH=/home/ubuntu/app/agents/todo-agent/venv/bin
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target